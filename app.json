{
  "expo": {
    "name": "Pitlane",
    "slug": "pitlane",
    "owner": "beo-johnny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pitlane",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.fiap.pitlane",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.fiap.pitlane",
      "adaptiveIcon": {
        "backgroundColor": "#00095B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#05070F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "pt-BR"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pitlane uses the camera to scan your vehicle's VIN barcode.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pitlane uses your location to find the nearest Ford dealer."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pitlane uses Face ID to unlock your session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1e8a99ce-e635-492f-92d3-0d50a858d5ef"
      }
    }
  }
}
