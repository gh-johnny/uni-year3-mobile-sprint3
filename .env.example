# Copy to .env.local — every variable is validated by Zod in src/config/env.ts
EXPO_PUBLIC_APP_ENV=development
# Optional: real endpoint for the outbox sync. Leave empty to use the simulated gateway.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SEED=2026
EXPO_PUBLIC_SYNC_INTERVAL_MS=15000
EXPO_PUBLIC_SIMULATED_FAILURE_RATE=0.15
